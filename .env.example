# ---------------------------------------------------------------------------
# Copiar a .env y ajustar. El .env NUNCA se sube: esta en .gitignore.
# Todos los valores tienen default seguro, asi que la solucion arranca sin .env.
# ---------------------------------------------------------------------------

# --- Servidor ---
PORT=3000
HOST=127.0.0.1

# --- Proveedor de LLM: mock | ollama | gemini ---
# mock   = extractor determinista, sin red y sin claves. Es el DEFAULT.
# ollama = modelo local. Requiere `ollama serve` y el modelo descargado.
# gemini = Google AI Studio (capa gratuita). Requiere GEMINI_API_KEY.
LLM_PROVIDER=mock

# Solo para LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Solo para LLM_PROVIDER=gemini.
# La clave se obtiene en https://aistudio.google.com/apikey — NO se versiona.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Timeout para la llamada al LLM (ms). Independiente del timeout del carrier.
# 30 s porque lo dicta el proveedor mas lento: un modelo local en CPU tarda ~9 s por
# extraccion en este equipo. Con Gemini conviene bajarlo a 5000-8000.
LLM_TIMEOUT_MS=30000

# --- Politica de resiliencia contra el proveedor de cotizaciones ---
# PROVIDER_MAX_ATTEMPTS son INTENTOS TOTALES, no reintentos adicionales:
# 3 significa tres llamadas como maximo (1 inicial + 2 reintentos).
PROVIDER_MAX_ATTEMPTS=3
# Timeout de CADA intento por separado.
# Va POR ENCIMA de la latencia normal del carrier (1000-3000 ms). Con 2500 se aborta
# ~25% de las llamadas que iban bien: el sistema se fabrica sus propios fallos. Medido.
PROVIDER_TIMEOUT_MS=3500
# Presupuesto total del ciclo completo, incluidas esperas de backoff.
# Corta aunque queden intentos: protege la latencia que ve el usuario.
PROVIDER_TOTAL_BUDGET_MS=9000
# Backoff exponencial con FULL JITTER: espera = random(0, min(cap, base * 2^n))
PROVIDER_BACKOFF_BASE_MS=250
PROVIDER_BACKOFF_CAP_MS=4000

# --- Mock del carrier (el proveedor externo inestable) ---
# Tasa de fallo intermitente: 0 = nunca falla, 1 = siempre falla.
# Para reproducir la caida total del proveedor: CARRIER_FAILURE_RATE=1
CARRIER_FAILURE_RATE=0.25
CARRIER_MIN_LATENCY_MS=1000
CARRIER_MAX_LATENCY_MS=3000
# Semilla del generador pseudoaleatorio del mock. Fijarla hace REPRODUCIBLE
# la secuencia de fallos, que es lo que permite adjuntar evidencia estable.
CARRIER_SEED=
